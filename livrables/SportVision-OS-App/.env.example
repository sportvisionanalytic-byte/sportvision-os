# Rien n'est obligatoire ici depuis le 23/09/2026.
#
# L'adresse de la base et la clé publique vivent maintenant dans app.json (expo.extra), pour
# qu'une compilation faite sans ce fichier ne produise plus une application muette. Voir
# src/lib/config.ts, qui explique pourquoi.
#
# Ces deux variables restent lues en priorité quand elles existent : c'est ce qui permet de
# pointer une base de recette sans toucher au code. Laisse ce fichier vide pour travailler sur
# la production.

# EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# Met l'application en démonstration : aucune base interrogée, aucune session ouverte.
# EXPO_PUBLIC_DEMO=1
