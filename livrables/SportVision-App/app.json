{
  "expo": {
    "name": "SportVision",
    "slug": "sportvision",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sportvision",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070B18",
    "newArchEnabled": true,
    "extra": {
      "supabaseUrl": "https://lulgezzpvrlbftbykzrc.supabase.co",
      "supabaseCle": "sb_publishable_N_S7DxALGutAd6KlQmpaTw_h7cHNaE4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.sportvision.app",
      "buildNumber": "4",
      "infoPlist": {
        "CFBundleDisplayName": "SportVision",
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Pour rouvrir SportVision sans retaper votre mot de passe. Votre visage ne quitte jamais votre téléphone et n'est jamais transmis à SportVision.",
        "NSCameraUsageDescription": "Pour vous reconnaître sur les photos de vos matchs, si vous y avez consenti. La comparaison se fait dans votre téléphone et aucune empreinte n'est conservée."
      }
    },
    "android": {
      "package": "fr.sportvision.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#070B18",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-secure-store",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#070B18"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
