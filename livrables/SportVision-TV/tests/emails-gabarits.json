[{"template_key":"auth.email_changed","subject_template":"L'adresse e-mail de votre compte SportVision a changé","body_html_template":"<!DOCTYPE html><html lang=\"fr\"><head><meta charset=\"UTF-8\"></head>\n   <body style=\"margin:0;padding:0;background:#0B1B33;font-family:Arial,sans-serif;color:#F7F9FC\">\n     <div style=\"max-width:520px;margin:32px auto;background:#10243E;border-radius:14px;overflow:hidden\">\n       <div style=\"background:#0B1B33;padding:26px 32px\"><div style=\"font-size:20px;font-weight:800;color:#fff\">SPORTVISION</div></div>\n       <div style=\"padding:28px 32px\">\n         <p style=\"font-size:14px;line-height:1.7;color:#9DAEC3\">L'adresse de connexion de votre compte a été remplacée par {{masked_new_email}} le {{changed_at_local}}.</p>\n         <p style=\"font-size:13px;color:#9DAEC3\">Si vous n'avez pas demandé ce changement, utilisez immédiatement le lien sécurisé de contestation ou contactez le support.</p>\n         <a href=\"{{dispute_url}}\" style=\"display:inline-block;margin-top:16px;background:#168BFF;color:#fff;text-decoration:none;padding:12px 22px;border-radius:9px;font-size:14px;font-weight:700\">Signaler ce changement</a>\n       </div>\n     </div>\n   </body></html>","required_variables":["masked_new_email","changed_at_local","dispute_url"]},{"template_key":"auth.email_verification","subject_template":"Confirmez votre adresse e-mail SportVision","body_html_template":"<!DOCTYPE html><html lang=\"fr\"><head><meta charset=\"UTF-8\"></head>\n   <body style=\"margin:0;padding:0;background:#0B1B33;font-family:Arial,sans-serif;color:#F7F9FC\">\n     <div style=\"max-width:520px;margin:32px auto;background:#10243E;border-radius:14px;overflow:hidden\">\n       <div style=\"background:#0B1B33;padding:26px 32px\"><div style=\"font-size:20px;font-weight:800;color:#fff\">SPORTVISION</div></div>\n       <div style=\"padding:28px 32px\">\n         <p style=\"font-size:15px;line-height:1.6\">Bonjour {{first_name}},</p>\n         <p style=\"font-size:14px;line-height:1.7;color:#9DAEC3\">Confirmez cette adresse afin d'activer votre compte et de sécuriser vos échanges avec SportVision.</p>\n         <p style=\"font-size:13px;color:#9DAEC3\">Le lien expire le {{expires_at_local}}. Si vous n'êtes pas à l'origine de cette demande, ignorez cet e-mail.</p>\n         <a href=\"{{verification_url}}\" style=\"display:inline-block;margin-top:16px;background:#168BFF;color:#fff;text-decoration:none;padding:12px 22px;border-radius:9px;font-size:14px;font-weight:700\">Confirmer mon adresse</a>\n       </div>\n     </div>\n   </body></html>","required_variables":["first_name","expires_at_local","verification_url"]},{"template_key":"auth.invitation","subject_template":"Vous êtes invité(e) à rejoindre SportVision Connect","body_html_template":"<!DOCTYPE html><html lang=\"fr\"><head><meta charset=\"UTF-8\"></head>\n   <body style=\"margin:0;padding:0;background:#0B1B33;font-family:Arial,sans-serif;color:#F7F9FC\">\n     <div style=\"max-width:520px;margin:32px auto;background:#10243E;border-radius:14px;overflow:hidden\">\n       <div style=\"background:#0B1B33;padding:26px 32px\"><div style=\"font-size:20px;font-weight:800;color:#fff\">SPORTVISION</div></div>\n       <div style=\"padding:28px 32px\">\n         <p style=\"font-size:15px;line-height:1.6\">Bonjour {{first_name}},</p>\n         <p style=\"font-size:14px;line-height:1.7;color:#9DAEC3\">{{inviter_name}} vous invite à rejoindre l'espace {{organization_name}} sur SportVision Connect avec le rôle « {{role_label}} ».</p>\n         <p style=\"font-size:13px;color:#9DAEC3\">Cette invitation expire le {{expires_at_local}}. Pour des raisons de sécurité, elle ne peut être utilisée qu'une seule fois.</p>\n         <a href=\"{{invitation_url}}\" style=\"display:inline-block;margin-top:16px;background:#168BFF;color:#fff;text-decoration:none;padding:12px 22px;border-radius:9px;font-size:14px;font-weight:700\">Accepter l'invitation</a>\n       </div>\n     </div>\n   </body></html>","required_variables":["first_name","inviter_name","organization_name","role_label","expires_at_local","invitation_url"]},{"template_key":"auth.password_changed","subject_template":"Votre mot de passe SportVision a été modifié","body_html_template":"<!DOCTYPE html><html lang=\"fr\"><head><meta charset=\"UTF-8\"></head>\n   <body style=\"margin:0;padding:0;background:#0B1B33;font-family:Arial,sans-serif;color:#F7F9FC\">\n     <div style=\"max-width:520px;margin:32px auto;background:#10243E;border-radius:14px;overflow:hidden\">\n       <div style=\"background:#0B1B33;padding:26px 32px\"><div style=\"font-size:20px;font-weight:800;color:#fff\">SPORTVISION</div></div>\n       <div style=\"padding:28px 32px\">\n         <p style=\"font-size:15px;line-height:1.6\">Bonjour {{first_name}},</p>\n         <p style=\"font-size:14px;line-height:1.7;color:#9DAEC3\">Le mot de passe de votre compte a été modifié le {{changed_at_local}}.</p>\n         <p style=\"font-size:13px;color:#9DAEC3\">Si vous êtes à l'origine de cette action, aucune démarche n'est nécessaire. Sinon, sécurisez immédiatement votre compte et contactez le support.</p>\n         <a href=\"{{security_url}}\" style=\"display:inline-block;margin-top:16px;background:#168BFF;color:#fff;text-decoration:none;padding:12px 22px;border-radius:9px;font-size:14px;font-weight:700\">Sécuriser mon compte</a>\n       </div>\n     </div>\n   </body></html>","required_variables":["first_name","changed_at_local","security_url"]},{"template_key":"auth.password_reset","subject_template":"Réinitialisez votre mot de passe SportVision","body_html_template":"<!DOCTYPE html><html lang=\"fr\"><head><meta charset=\"UTF-8\"></head>\n   <body style=\"margin:0;padding:0;background:#0B1B33;font-family:Arial,sans-serif;color:#F7F9FC\">\n     <div style=\"max-width:520px;margin:32px auto;background:#10243E;border-radius:14px;overflow:hidden\">\n       <div style=\"background:#0B1B33;padding:26px 32px\"><div style=\"font-size:20px;font-weight:800;color:#fff\">SPORTVISION</div></div>\n       <div style=\"padding:28px 32px\">\n         <p style=\"font-size:15px;line-height:1.6\">Bonjour {{first_name}},</p>\n         <p style=\"font-size:14px;line-height:1.7;color:#9DAEC3\">Une demande de réinitialisation a été effectuée pour votre compte SportVision.</p>\n         <p style=\"font-size:13px;color:#9DAEC3\">Utilisez le bouton ci-dessous avant {{expires_at_local}}. Ce lien est personnel, à usage unique et ne doit pas être transféré.</p>\n         <p style=\"font-size:13px;color:#9DAEC3\">Si vous n'avez rien demandé, vous pouvez ignorer ce message. Votre mot de passe actuel reste inchangé.</p>\n         <a href=\"{{reset_url}}\" style=\"display:inline-block;margin-top:16px;background:#168BFF;color:#fff;text-decoration:none;padding:12px 22px;border-radius:9px;font-size:14px;font-weight:700\">Réinitialiser mon mot de passe</a>\n       </div>\n     </div>\n   </body></html>","required_variables":["first_name","expires_at_local","reset_url"]},{"template_key":"auth.welcome","subject_template":"Bienvenue sur SportVision Connect","body_html_template":"<!DOCTYPE html><html lang=\"fr\"><head><meta charset=\"UTF-8\"></head>\n   <body style=\"margin:0;padding:0;background:#0B1B33;font-family:Arial,sans-serif;color:#F7F9FC\">\n     <div style=\"max-width:520px;margin:32px auto;background:#10243E;border-radius:14px;overflow:hidden\">\n       <div style=\"background:#0B1B33;padding:26px 32px\"><div style=\"font-size:20px;font-weight:800;color:#fff\">SPORTVISION</div></div>\n       <div style=\"padding:28px 32px\">\n         <p style=\"font-size:15px;line-height:1.6\">Bonjour {{first_name}},</p>\n         <p style=\"font-size:14px;line-height:1.7;color:#9DAEC3\">Votre compte est maintenant actif. Vous pouvez accéder à vos demandes, documents, rendez-vous et prestations depuis votre espace sécurisé.</p>\n         <p style=\"font-size:13px;color:#9DAEC3\">Besoin d'aide ? Répondez à cet e-mail ou contactez {{support_email}}.</p>\n         <a href=\"{{app_url}}\" style=\"display:inline-block;margin-top:16px;background:#168BFF;color:#fff;text-decoration:none;padding:12px 22px;border-radius:9px;font-size:14px;font-weight:700\">Accéder à mon espace</a>\n       </div>\n     </div>\n   </body></html>","required_variables":["first_name","support_email","app_url"]},{"template_key":"clubplus.abonnement_active","subject_template":"Votre abonnement Club+ est activé","body_html_template":"<!DOCTYPE html><html lang=\"fr\"><head><meta charset=\"UTF-8\"></head>\n   <body style=\"margin:0;padding:0;background:#0B1B33;font-family:Arial,sans-serif;color:#F7F9FC\">\n     <div style=\"max-width:520px;margin:32px auto;background:#10243E;border-radius:14px;overflow:hidden\">\n       <div style=\"background:#0B1B33;padding:26px 32px\"><div style=\"font-size:20px;font-weight:800;color:#fff\">SPORTVISION</div><div style=\"font-size:10px;color:#32D8E6;letter-spacing:.1em;margin-top:2px\">CLUB+</div></div>\n       <div style=\"padding:28px 32px\">\n         <p style=\"font-size:15px;line-height:1.6\">Bonjour {{first_name}},</p>\n         <p style=\"font-size:14px;line-height:1.7;color:#9DAEC3\">Votre abonnement <strong>{{plan_label}}</strong> est activé. Merci pour votre confiance.</p>\n         <div style=\"background:#0B1B33;border-radius:10px;padding:16px 20px;margin:18px 0\">\n           <p style=\"font-size:12px;margin:0;color:#9DAEC3\">Montant prélevé</p>\n           <p style=\"font-size:22px;font-weight:800;color:#32D8E6;margin:4px 0 0\">{{montant}}</p>\n         </div>\n         <p style=\"font-size:13px;color:#9DAEC3\">Vous pouvez gérer votre abonnement (moyen de paiement, factures, résiliation) à tout moment depuis votre espace Club+, bouton « Gérer mon abonnement ».</p>\n       </div>\n     </div>\n   </body></html>","required_variables":["first_name","plan_label","montant"]},{"template_key":"clubplus.abonnement_resilie","subject_template":"Votre abonnement Club+ a été résilié","body_html_template":"<!DOCTYPE html><html lang=\"fr\"><head><meta charset=\"UTF-8\"></head>\n   <body style=\"margin:0;padding:0;background:#0B1B33;font-family:Arial,sans-serif;color:#F7F9FC\">\n     <div style=\"max-width:520px;margin:32px auto;background:#10243E;border-radius:14px;overflow:hidden\">\n       <div style=\"background:#0B1B33;padding:26px 32px\"><div style=\"font-size:20px;font-weight:800;color:#fff\">SPORTVISION</div><div style=\"font-size:10px;color:#32D8E6;letter-spacing:.1em;margin-top:2px\">CLUB+</div></div>\n       <div style=\"padding:28px 32px\">\n         <p style=\"font-size:15px;line-height:1.6\">Bonjour {{first_name}},</p>\n         <p style=\"font-size:14px;line-height:1.7;color:#9DAEC3\">Votre abonnement Club+ a été résilié, avec effet au <strong>{{date_effet}}</strong>. Vous ne serez plus prélevé.</p>\n         <p style=\"font-size:13px;color:#9DAEC3\">Si cette résiliation ne correspond pas à votre demande, contactez-nous dès que possible — répondez directement à cet e-mail.</p>\n       </div>\n     </div>\n   </body></html>","required_variables":["first_name","date_effet"]},{"template_key":"clubplus.paiement_echoue","subject_template":"Le prélèvement de votre abonnement Club+ a échoué","body_html_template":"<!DOCTYPE html><html lang=\"fr\"><head><meta charset=\"UTF-8\"></head>\n   <body style=\"margin:0;padding:0;background:#0B1B33;font-family:Arial,sans-serif;color:#F7F9FC\">\n     <div style=\"max-width:520px;margin:32px auto;background:#10243E;border-radius:14px;overflow:hidden\">\n       <div style=\"background:#0B1B33;padding:26px 32px\"><div style=\"font-size:20px;font-weight:800;color:#fff\">SPORTVISION</div><div style=\"font-size:10px;color:#32D8E6;letter-spacing:.1em;margin-top:2px\">CLUB+</div></div>\n       <div style=\"padding:28px 32px\">\n         <p style=\"font-size:15px;line-height:1.6\">Bonjour {{first_name}},</p>\n         <p style=\"font-size:14px;line-height:1.7;color:#9DAEC3\">Le prélèvement de votre abonnement Club+ d'un montant de <strong>{{montant}}</strong> n'a pas pu être effectué.</p>\n         <p style=\"font-size:14px;line-height:1.7;color:#9DAEC3\">Pour continuer à profiter de votre abonnement sans interruption, merci de mettre à jour votre moyen de paiement dès que possible.</p>\n         <a href=\"{{lien_gestion}}\" style=\"display:inline-block;background:#168BFF;color:#fff;text-decoration:none;padding:12px 22px;border-radius:9px;font-size:14px;font-weight:700;margin-top:8px\">Mettre à jour mon moyen de paiement</a>\n         <p style=\"font-size:12px;color:#9DAEC3;margin-top:18px\">Sans régularisation, votre abonnement sera considéré comme impayé et pourra être suspendu.</p>\n       </div>\n     </div>\n   </body></html>","required_variables":["first_name","montant","lien_gestion"]},{"template_key":"connect.contenu_disponible","subject_template":"Vos contenus SportVision sont disponibles","body_html_template":"<!DOCTYPE html><html lang=\"fr\"><head><meta charset=\"UTF-8\"></head>\n   <body style=\"margin:0;padding:0;background:#0B1B33;font-family:Arial,sans-serif;color:#F7F9FC\">\n     <div style=\"max-width:520px;margin:32px auto;background:#10243E;border-radius:14px;overflow:hidden\">\n       <div style=\"background:#0B1B33;padding:26px 32px\"><div style=\"font-size:20px;font-weight:800;color:#fff\">SPORTVISION</div></div>\n       <div style=\"padding:28px 32px\">\n         <p style=\"font-size:15px;line-height:1.6\">Bonjour {{first_name}},</p>\n         <p style=\"font-size:14px;line-height:1.7;color:#9DAEC3\">Vos photos et vidéos concernant <strong>{{titre}}</strong> sont désormais disponibles dans votre espace SportVision Connect, rubrique « Mes contenus ».</p>\n         <p style=\"font-size:13px;color:#9DAEC3\">Connectez-vous pour les consulter, les télécharger et les partager.</p>\n         <a href=\"{{app_url}}\" style=\"display:inline-block;margin-top:16px;background:#168BFF;color:#fff;text-decoration:none;padding:12px 22px;border-radius:9px;font-size:14px;font-weight:700\">Voir mes contenus</a>\n       </div>\n     </div>\n   </body></html>","required_variables":["first_name","titre","app_url"]},{"template_key":"finance.expense_due_soon","subject_template":"Échéance à venir : {{libelle}}","body_html_template":"<!DOCTYPE html><html lang=\"fr\"><head><meta charset=\"UTF-8\"></head>\n   <body style=\"margin:0;padding:0;background:#0B1B33;font-family:Arial,sans-serif;color:#F7F9FC\">\n     <div style=\"max-width:520px;margin:32px auto;background:#10243E;border-radius:14px;overflow:hidden\">\n       <div style=\"background:#0B1B33;padding:26px 32px\"><div style=\"font-size:20px;font-weight:800;color:#fff\">SPORTVISION</div></div>\n       <div style=\"padding:28px 32px\">\n         <p style=\"font-size:15px;line-height:1.6\">Bonjour {{first_name}},</p>\n         <p style=\"font-size:14px;line-height:1.7;color:#9DAEC3\">Une dépense récurrente arrive à échéance :</p>\n         <div style=\"background:#0B1B33;border-radius:10px;padding:16px 20px;margin:14px 0\">\n           <p style=\"font-size:14px;margin:0 0 6px;color:#F7F9FC\"><strong>{{libelle}}</strong> ({{categorie}})</p>\n           <p style=\"font-size:14px;margin:0 0 6px;color:#F7F9FC\">Montant TTC : <strong>{{montant_ttc}}</strong></p>\n           <p style=\"font-size:14px;margin:0;color:#F7F9FC\">Échéance : <strong>{{date_echeance_local}}</strong></p>\n         </div>\n         <p style=\"font-size:13px;color:#9DAEC3\">Pensez à vérifier le règlement ou le renouvellement de cet engagement dans SportVision OS, rubrique Dépenses & fournisseurs.</p>\n       </div>\n     </div>\n   </body></html>","required_variables":["first_name","libelle","categorie","montant_ttc","date_echeance_local"]},{"template_key":"galerie.commande_prete","subject_template":"Votre commande {{album}} est confirmée","body_html_template":"<div style=\"font-family:system-ui,-apple-system,Segoe UI,sans-serif;background:#09081a;color:#f7f7fb;padding:32px 20px\">\n  <div style=\"max-width:520px;margin:0 auto\">\n    <div style=\"font-size:15px;font-weight:700;letter-spacing:-.01em;margin-bottom:26px\">SportVision</div>\n    <h1 style=\"font-size:22px;font-weight:800;margin:0 0 12px\">Merci {{prenom}} !</h1>\n    <p style=\"font-size:14px;line-height:1.6;color:#c7c7de;margin:0 0 6px\">\n      Votre commande <strong style=\"color:#f7f7fb\">{{album}}</strong> est confirmée.\n    </p>\n    <p style=\"font-size:14px;line-height:1.6;color:#c7c7de;margin:0 0 24px\">\n      {{consigne}}\n    </p>\n    <a href=\"{{lien}}\" style=\"display:inline-block;background:linear-gradient(120deg,#a855f7,#4f7dff 55%,#22d3ee);color:#fff;text-decoration:none;font-weight:700;font-size:15px;padding:14px 28px;border-radius:999px\">{{cta}}</a>\n    <p style=\"font-size:12.5px;line-height:1.6;color:#7a7a9c;margin:24px 0 0\">\n      Ce lien reste valable jusqu'au {{expiration}}. Créez votre compte SportVision Connect depuis\n      cette page pour conserver vos photos sans limite de durée.\n    </p>\n    <p style=\"font-size:12px;color:#6c6c90;margin:20px 0 0\">Commande {{numero}} — {{montant}}</p>\n  </div>\n</div>","required_variables":["prenom","album","consigne","cta","lien","expiration","numero","montant"]}]