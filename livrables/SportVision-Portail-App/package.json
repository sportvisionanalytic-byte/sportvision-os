{
  "name": "sportvision-app",
  "version": "1.0.0",
  "private": true,
  "description": "SportVision — app mobile (espace client) via Capacitor",
  "scripts": {
    "build:web": "cp ../SportVision-Portail/SportVision-Portail.html www/index.html",
